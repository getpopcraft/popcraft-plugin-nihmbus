{
  "name": "popcraft-plugin-nihmbus",
  "version": "0.3.0",
  "private": true,
  "description": "The Nihmbus plugin for PopCraft: connects your PopCraft editor to Nihmbus agents.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "pack": "node scripts/pack.mjs",
    "lint": "eslint . && prettier --check . && markdownlint-cli2 \"**/*.md\" \"#node_modules\" && node scripts/icons.mjs --check",
    "format": "prettier --write .",
    "icons": "node scripts/icons.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "markdownlint-cli2": "^0.20.0",
    "prettier": "^3.6.2"
  }
}

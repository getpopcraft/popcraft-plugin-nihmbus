{
  "id": "popcraft.nihmbus",
  "name": "Nihmbus",
  "version": "0.2.0",
  "description": "Connect this editor to Nihmbus so your Nihmbus agents can design, animate and export in it. Lives in the right-hand panel.",
  "author": "PopCraft",
  "main": "main.js",
  "ui": "ui.html",
  "permissions": ["read", "write", "export", "network"],
  "contributes": {
    "panels": [
      {
        "id": "nihmbus",
        "title": "Nihmbus",
        "icon": "data:image/svg+xml;base64,",
        "side": "right",
        "command": "connect",
        "autostart": true
      }
    ]
  },
  "icon": "https://raw.githubusercontent.com/getpopcraft/popcraft-plugin-nihmbus/main/assets/icon-color.svg"
}
